<Window x:Class="PluginAutoMaker.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="360" Width="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="出力ディレクトリ" Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" />
        <TextBox Text="{Binding OutputDirectory}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Text="Paper保存ディレクトリ" Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" />
        <TextBox Text="{Binding PaperDirectory}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Text="Paper Jar パス" Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" />
        <TextBox Text="{Binding PreferredPaperJarPath}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Text="Gradle Wrapper バージョン" Grid.Row="3" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" />
        <TextBox Text="{Binding GradleVersion}" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Text="テストタイムアウト (秒)" Grid.Row="4" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" />
        <TextBox Text="{Binding TestTimeoutSeconds}" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" />

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="12">
            <Button Content="保存" Width="100" Click="OnSaveClick" IsDefault="True" />
            <Button Content="キャンセル" Width="100" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

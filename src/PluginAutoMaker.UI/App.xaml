<Application x:Class="PluginAutoMaker.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="LogInfoBrush" Color="#FF1E88E5" />
            <SolidColorBrush x:Key="LogWarnBrush" Color="#FFFDD835" />
            <SolidColorBrush x:Key="LogErrorBrush" Color="#FFE53935" />
            <SolidColorBrush x:Key="LogTraceBrush" Color="#FF90A4AE" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
